PORT=5000
NODE_ENV=development
DEMO_MODE=true

# Groq Cloud API Key (Optional - will use realistic local museum AI if left empty)
GROQ_API_KEY=

# MongoDB Atlas URI (Optional - will use in-memory store if left empty)
MONGODB_URI=

# Mapbox Access Token (Optional - Leaflet & vector floorplan runs with zero configuration)
MAPBOX_TOKEN=
