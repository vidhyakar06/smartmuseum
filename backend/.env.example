PORT=5000
NODE_ENV=development
DEMO_MODE=false

# Google Gemini API Key (Primary & Recommended)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq Cloud API Key (Secondary/Alternative)
GROQ_API_KEY=

# MongoDB Atlas URI (Optional - will use in-memory store if left empty)
MONGODB_URI=

# Mapbox Access Token (Optional - Leaflet & vector floorplan runs with zero configuration)
MAPBOX_TOKEN=
